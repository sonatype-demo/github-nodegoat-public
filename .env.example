# Copy this file to .env and replace placeholders locally.
# Never commit .env. It is intentionally ignored by Git.

# NodeGoat runtime configuration
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/nodegoat

# Central Nexus Repository npm group (non-sensitive)
NPM_REGISTRY_URL=https://nexus.wn.leyux.de/repository/npm-group/
NPM_REGISTRY_HOST=nexus.wn.leyux.de/repository/npm-group/

# Sensitive: Base64 of username:password or token-name:token-password.
# Keep the placeholder in this template; put the real value only in .env.
NPM_AUTH_TOKEN=REPLACE_WITH_BASE64_AUTH_VALUE
